# Copy this file to .env, then fill in your key.
#
#   cp .env.example .env
#   ./run.sh
#
# run.sh sources .env, so use plain KEY=value lines with no spaces around `=`.
# Never commit .env; it is ignored by .gitignore.

# Required. An OpenAI API key, or any key accepted by your compatible server.
SPIN_VARIABLE_OPENAI_API_KEY=sk-your-key-here

# Optional. Origin only, no /v1 or path; the app appends /v1.
# SPIN_VARIABLE_OPENAI_BASE_URL=https://api.openai.com

# Optional. Any Chat Completions model that supports tool calling.
# SPIN_VARIABLE_MODEL=gpt-5

# Optional. Shared token that gates the UI and API. Set this before deploying
# publicly; an empty value means anyone who can reach the app can spend your key.
# SPIN_VARIABLE_ACCESS_TOKEN=

# Optional. error, warn, info, debug, or trace.
# SPIN_VARIABLE_LOG_LEVEL=info

# Optional. Maximum model turns before a forced final summary (1-20).
# SPIN_VARIABLE_MAX_TURNS=10
